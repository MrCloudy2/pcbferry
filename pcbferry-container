#!/usr/bin/env bash
# Run pcbferry from the container image, mapping host paths in and out.
#
#   pcbferry-container [options] INPUT OUTPUT_DIR
#
# INPUT's folder is mounted read-only. A .PrjPcb that lists documents outside
# its own folder (../Libraries/...) needs PCBFERRY_ROOT set to a folder
# containing all of them. Options are passed through; --board's path must also
# be under that folder.
#
# Environment: PCBFERRY_IMAGE (default localhost/pcbferry:latest),
#              PCBFERRY_ENGINE (podman or docker; default: whichever exists).
set -euo pipefail

image=${PCBFERRY_IMAGE:-localhost/pcbferry:latest}
engine=${PCBFERRY_ENGINE:-$(command -v podman >/dev/null && echo podman || echo docker)}

opts=() pos=() board=
while [[ $# -gt 0 ]]; do
    case $1 in
        --name|--footprint-slash) opts+=("$1" "$2"); shift ;;
        --board) board=$2; shift ;;
        --board=*) board=${1#--board=} ;;
        -*) opts+=("$1") ;;
        *) pos+=("$1") ;;
    esac
    shift
done
if [[ ${#pos[@]} -ne 2 ]]; then
    exec "$engine" run --rm "$image" "${opts[@]:---help}"
fi

input=$(realpath -- "${pos[0]}")
output=$(realpath -m -- "${pos[1]}")
root=$(realpath -- "${PCBFERRY_ROOT:-$(dirname -- "$input")}")
case $input in "$root"/*) ;; *) echo "pcbferry: $input is not under $root" >&2; exit 2 ;; esac
mkdir -p -- "$output"
if [[ -n $board ]]; then
    board=$(realpath -- "$board")
    case $board in "$root"/*) ;; *) echo "pcbferry: $board is not under $root" >&2; exit 2 ;; esac
    opts+=(--board "/in/${board#"$root"/}")
fi

user=(--user "$(id -u):$(id -g)")
[[ $(basename -- "$engine") == podman ]] && user=(--userns=keep-id)

# Docker Hub's image name has no localhost/ prefix.
if [[ $(basename -- "$engine") == docker && $image == localhost/* ]]; then
    image=${image#localhost/}
fi

exec "$engine" run --rm "${user[@]}" \
    -v "$root:/in:ro" -v "$output:/out" \
    "$image" "${opts[@]}" "/in/${input#"$root"/}" /out
