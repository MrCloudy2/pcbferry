     ALTIUM_BINARY_PARSER reader( aAltiumPcbFile, aEntry );
 
+    // Vias without their own mask setting follow the highest-priority solder mask rule that
+    // applies to every via (IsVia) or to everything. A negative expansion that closes the
+    // opening is how Altium designs tent vias by rule; KiCad vias take no mask rules.
+    const ARULE6* viaMaskRule = nullptr;
+
+    if( auto rules = m_rules.find( ALTIUM_RULE_KIND::SOLDER_MASK_EXPANSION ); rules != m_rules.end() )
+    {
+        for( const ARULE6& rule : rules->second )
+        {
+            wxString scope = rule.scope1expr.Strip( wxString::both );
+
+            if( rule.enabled && IsAltiumScopeAll( rule.scope2expr )
+                && ( IsAltiumScopeAll( scope ) || scope.IsSameAs( wxS( "IsVia" ), false ) ) )
+            {
+                viaMaskRule = &rule;
+                break;
+            }
+        }
+    }
+
