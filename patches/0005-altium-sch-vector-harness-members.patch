+    // The vector label ("AD[0..11]") on the sub-bus that starts at aStart, if any.
+    auto vectorLabelAt =
+            [&]( const VECTOR2I& aStart ) -> SCH_LABEL*
+            {
+                std::set<SCH_LINE*>   visited;
+                std::vector<VECTOR2I> todo = { aStart };
+
+                while( !todo.empty() )
+                {
+                    VECTOR2I pt = todo.back();
+                    todo.pop_back();
+
+                    auto it = busLineMap.find( pt );
+
+                    if( it == busLineMap.end() )
+                        continue;
+
+                    for( SCH_LINE* line : it->second )
+                    {
+                        if( !visited.insert( line ).second )
+                            continue;
+
+                        for( SCH_ITEM* elem : screen->Items().Overlapping( SCH_LABEL_T, line->GetBoundingBox() ) )
+                        {
+                            SCH_LABEL* label = static_cast<SCH_LABEL*>( elem );
+
+                            if( label->GetText().Contains( wxT( "[" ) )
+                                && line->HitTest( label->GetPosition() ) )
+                            {
+                                return label;
+                            }
+                        }
+
+                        todo.push_back( KIGEOM::GetOtherEnd( line->GetSeg(), pt ) );
+                    }
+                }
+
+                return nullptr;
+            };
