+/**
+ * A project import parses every document as a top-level sheet first, so the symbols of a
+ * document that turns out to be a sub-sheet carry their instance under that discarded sheet's
+ * path. Move each such instance to the path the sheet has in the final hierarchy, where
+ * variants and saving look for it.
+ */
+void rehomeSymbolInstances( SCH_SHEET* aRoot )
+{
+    SCH_SHEET_LIST     sheetList( aRoot );
+    std::set<wxString> validPaths;
+
+    for( const SCH_SHEET_PATH& path : sheetList )
+        validPaths.insert( path.Path().AsString() );
+
+    std::set<SCH_SYMBOL*> moved;
+
+    for( const SCH_SHEET_PATH& path : sheetList )
+    {
+        KIID_PATH realPath = path.Path();
+
+        for( SCH_ITEM* item : path.LastScreen()->Items().OfType( SCH_SYMBOL_T ) )
+        {
+            SCH_SYMBOL*         symbol = static_cast<SCH_SYMBOL*>( item );
+            SCH_SYMBOL_INSTANCE existing;
+
+            if( symbol->GetInstance( existing, realPath ) )
+                continue;
+
+            for( const SCH_SYMBOL_INSTANCE& instance : symbol->GetInstances() )
+            {
+                if( !validPaths.contains( instance.m_Path.AsString() ) )
+                {
+                    SCH_SYMBOL_INSTANCE rehomed = instance;
+                    rehomed.m_Path = realPath;
+                    symbol->AddHierarchicalReference( rehomed );
+                    moved.insert( symbol );
+                    break;
+                }
+            }
+        }
+    }
+
+    for( SCH_SYMBOL* symbol : moved )
+    {
+        std::vector<KIID_PATH> stale;
+
+        for( const SCH_SYMBOL_INSTANCE& instance : symbol->GetInstances() )
+        {
+            if( !validPaths.contains( instance.m_Path.AsString() ) )
+                stale.push_back( instance.m_Path );
+        }
+
+        for( const KIID_PATH& path : stale )
+            symbol->RemoveInstance( path );
+    }
+}
