+namespace
+{
+/// The KiCad field an Altium parameter became (see SCH_IO_ALTIUM::ParseParameter), or empty.
+wxString altiumParamField( const SCH_SYMBOL& aSymbol, const wxString& aParam )
+{
+    wxString upper = aParam.Upper();
+
+    if( upper == wxS( "COMMENT" ) )
+        return aSymbol.GetField( FIELD_T::VALUE )->GetName();
+
+    if( upper == wxS( "DESCRIPTION" ) )
+        return aSymbol.GetField( FIELD_T::DESCRIPTION )->GetName();
+
+    if( upper == wxS( "VALUE" ) || upper == wxS( "FOOTPRINT" ) )
+        upper = wxS( "ALTIUM_" ) + upper;
+    else if( upper == wxS( "DATASHEET" ) && !aSymbol.GetField( wxS( "ALTIUM_DATASHEET" ) ) )
+        return aSymbol.GetField( FIELD_T::DATASHEET )->GetName();
+    else if( upper == wxS( "DATASHEET" ) )
+        upper = wxS( "ALTIUM_DATASHEET" );
+
+    return aSymbol.GetField( upper ) ? upper : wxString();
+}
+
+
+/// Apply one Altium variant's parameter overrides for a symbol to its KiCad variant.
+void applyAltiumParamVariations( const SCH_SYMBOL& aSymbol, const std::map<wxString, wxString>& aParams,
+                                 SCH_SYMBOL_VARIANT& aVariant )
+{
+    for( const auto& [name, value] : aParams )
+    {
+        wxString field = altiumParamField( aSymbol, name );
+
+        if( field.empty() )
+            continue; // Altium system parameters (Library Reference, Pin Info, ...) have no field
+
+        wxString text = value;
+
+        // "=Name" takes another parameter's value: the variant's own, else the symbol's.
+        if( text.StartsWith( wxS( "=" ) ) )
+        {
+            wxString source = text.Mid( 1 );
+            text = wxEmptyString;
+            bool found = false;
+
+            for( const auto& [otherName, otherValue] : aParams )
+            {
+                if( otherName.CmpNoCase( source ) == 0 )
+                {
+                    text = otherValue;
+                    found = true;
+                    break;
+                }
+            }
+
+            if( !found )
+            {
+                wxString sourceField = altiumParamField( aSymbol, source );
+
+                if( sourceField.empty() )
+                    continue;
+
+                text = aSymbol.GetField( sourceField )->GetText();
+            }
+        }
+
+        aVariant.m_Fields[field] = text;
+    }
+}
