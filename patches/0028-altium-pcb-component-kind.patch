diff --git a/pcbnew/pcb_io/altium/altium_pcb.cpp b/pcbnew/pcb_io/altium/altium_pcb.cpp
index 82c07de..42b35f9 100644
--- a/pcbnew/pcb_io/altium/altium_pcb.cpp
+++ b/pcbnew/pcb_io/altium/altium_pcb.cpp
@@ -2076,6 +2076,14 @@ void ALTIUM_PCB::ParseComponents6Data( const ALTIUM_PCB_COMPOUND_FILE& aAltiumPc
         footprint->SetSheetfile( elem.sourceHierachicalPath + wxT( ".kicad_sch" ));
 
         footprint->SetLocked( elem.locked );
+
+        // Altium's component type: Graphical is on the board only, and it, Net Tie (No BOM)
+        // and Standard (No BOM) stay out of the bill of materials
+        if( elem.componentkind == 2 )
+            footprint->SetAttributes( footprint->GetAttributes() | FP_BOARD_ONLY );
+
+        if( elem.componentkind == 2 || elem.componentkind == 4 || elem.componentkind == 5 )
+            footprint->SetAttributes( footprint->GetAttributes() | FP_EXCLUDE_FROM_BOM );
         footprint->Reference().SetVisible( elem.nameon );
         footprint->Value().SetVisible( elem.commenton );
         footprint->SetLayer( elem.layer == ALTIUM_LAYER::TOP_LAYER ? F_Cu : B_Cu );
