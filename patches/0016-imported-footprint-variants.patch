+    std::map<wxString, FOOTPRINT*> moveToCache; // lib id -> a placed copy
+
+    for( FOOTPRINT* fp : aBoard->Footprints() )
+    {
+        const LIB_ID& id = fp->GetFPID();
+
+        if( !id.IsValid() || id.GetUniStringLibNickname() == aCacheNickname )
+            continue;
+
+        const FOOTPRINT* lib = libraryFor( id );
+
+        if( lib && !matchesLibrary( fp, lib, nullptr ) )
+            moveToCache.emplace( id.Format().wx_str(), fp );
+    }
+
+    if( !moveToCache.empty() )
+    {
+        try
+        {
+            IO_RELEASER<PCB_IO> io( PCB_IO_MGR::FindPlugin( PCB_IO_MGR::KICAD_SEXP ) );
+
+            if( !wxDir::Exists( aCachePath ) )
+                io->CreateLibrary( aCachePath );
+
+            for( auto& [key, fp] : moveToCache )
+            {
+                std::unique_ptr<FOOTPRINT> copy( static_cast<FOOTPRINT*>( fp->Clone() ) );
+                LIB_ID                     id = copy->GetFPID();
+                id.SetLibNickname( aCacheNickname );
+                copy->SetFPID( id );
+                copy->SetReference( wxS( "REF**" ) );
+                io->FootprintSave( aCachePath, copy.get() );
+            }
+
+            std::optional<LIBRARY_TABLE*> table =
+                    Pgm().GetLibraryManager().Table( LIBRARY_TABLE_TYPE::FOOTPRINT, LIBRARY_TABLE_SCOPE::PROJECT );
+
+            if( table && !( *table )->HasRow( aCacheNickname ) )
+            {
+                LIBRARY_TABLE_ROW& row = ( *table )->InsertRow();
+                row.SetNickname( aCacheNickname );
+                row.SetURI( wxS( "${KIPRJMOD}/" ) + wxFileName( aCachePath, wxEmptyString ).GetDirs().Last() );
+                row.SetType( wxS( "KiCad" ) );
+                row.SetOptions( FOOTPRINT_IMPORT_RECONCILER::ManagedCacheOption() );
+                ( *table )->Save();
+            }
+
+            for( FOOTPRINT* fp : aBoard->Footprints() )
+            {
+                if( moveToCache.count( fp->GetFPID().Format().wx_str() ) )
+                {
+                    LIB_ID id = fp->GetFPID();
+                    id.SetLibNickname( aCacheNickname );
+                    fp->SetFPID( id );
+                }
+            }
+        }
+        catch( const IO_ERROR& ioe )
+        {
+            aReporter.Report( wxString::Format( _( "Could not add footprints to the import library: %s" ),
+                                                ioe.What() ),
+                              RPT_SEVERITY_WARNING );
+        }
+    }
+
+    int conformed = 0;
+
+    for( FOOTPRINT* fp : aBoard->Footprints() )
+    {
+        const LIB_ID& id = fp->GetFPID();
+
+        if( !id.IsValid() )
+            continue;
+
+        const FOOTPRINT* lib = libraryFor( id );
+
+        if( !lib || !fp->FootprintNeedsUpdate( lib, BOARD_ITEM::COMPARE_FLAGS::DRC ) )
+            continue;
+
+        std::unique_ptr<FOOTPRINT> placed = placeLike( *lib, *fp, aBoard );
+        std::map<PAD*, PAD*>       padPairs;
+
+        if( matchesWithin( *fp, *placed, &padPairs ) )
+        {
+            takeGeometry( *fp, *placed, padPairs );
+            conformed++;
+        }
+
+        // Must not have a parent when destroyed (see FOOTPRINT::FootprintNeedsUpdate())
+        placed->SetParent( nullptr );
+    }
+
+    return conformed;
+}
