+// The library parity check's pad comparison (drc_test_provider_library_parity.cpp)
+bool padNeedsUpdate( const PAD* a, const PAD* bLib, REPORTER* aReporter );
+
+
+namespace
+{
+// Altium rounds a rotated or mirrored component's primitives when it stores them, so placed
+// copies of one footprint differ from its definition by tens of nanometres, which KiCad's library
+// parity check (no tolerance) reports as a different footprint.
+constexpr int IMPORT_TOLERANCE = 50; // nm
+
+
+bool nearPt( const VECTOR2I& a, const VECTOR2I& b )
+{
+    return std::abs( a.x - b.x ) <= IMPORT_TOLERANCE && std::abs( a.y - b.y ) <= IMPORT_TOLERANCE;
+}
+
+
+std::vector<VECTOR2I> keyPoints( const BOARD_ITEM* aItem )
+{
+    std::vector<VECTOR2I> pts;
+
+    if( const PCB_SHAPE* shape = dynamic_cast<const PCB_SHAPE*>( aItem ) )
+    {
+        switch( shape->GetShape() )
+        {
+        case SHAPE_T::ARC:
+            pts = { shape->GetStart(), shape->GetArcMid(), shape->GetEnd() };
+            break;
+
+        case SHAPE_T::POLY:
+            for( auto it = shape->GetPolyShape().CIterateWithHoles(); it; ++it )
+                pts.push_back( *it );
+
+            break;
+
+        case SHAPE_T::BEZIER:
+            pts = { shape->GetStart(), shape->GetBezierC1(), shape->GetBezierC2(), shape->GetEnd() };
+            break;
+
+        default:
+            pts = { shape->GetStart(), shape->GetEnd() };
+            break;
+        }
+
+        pts.emplace_back( shape->GetWidth(), 0 );
+    }
+    else if( const PCB_TEXT* text = dynamic_cast<const PCB_TEXT*>( aItem ) )
+    {
+        pts = { text->GetPosition() };
+    }
+
+    return pts;
+}
+
+
+bool sameWithin( const BOARD_ITEM* a, const BOARD_ITEM* b )
+{
+    if( a->Type() != b->Type() || a->GetLayer() != b->GetLayer() )
+        return false;
+
+    const PCB_SHAPE* sa = dynamic_cast<const PCB_SHAPE*>( a );
+    const PCB_SHAPE* sb = dynamic_cast<const PCB_SHAPE*>( b );
+
+    if( sa && sb && sa->GetShape() != sb->GetShape() )
+        return false;
+
+    const PCB_TEXT* ta = dynamic_cast<const PCB_TEXT*>( a );
+    const PCB_TEXT* tb = dynamic_cast<const PCB_TEXT*>( b );
+
+    if( ta && tb && ta->GetText() != tb->GetText() )
+        return false;
+
+    std::vector<VECTOR2I> pa = keyPoints( a ), pb = keyPoints( b );
+
+    if( pa.size() != pb.size() )
+        return false;
+
+    for( size_t i = 0; i < pa.size(); ++i )
+    {
+        if( !nearPt( pa[i], pb[i] ) )
+            return false;
+    }
+
+    return true;
+}
+
+
+/// A placed footprint as it is saved to a library (PCB_IO_KICAD_SEXPR::FootprintSave()).
+std::unique_ptr<FOOTPRINT> libraryForm( const FOOTPRINT& aPlaced )
+{
+    std::unique_ptr<FOOTPRINT> lib( static_cast<FOOTPRINT*>( aPlaced.Clone() ) );
+
+    lib->SetOrientation( ANGLE_0 );
+
+    if( lib->GetLayer() != F_Cu )
+        lib->Flip( lib->GetPosition(), FLIP_DIRECTION::TOP_BOTTOM );
+
+    lib->SetPosition( { 0, 0 } );
+    lib->SetParent( nullptr );
+    return lib;
+}
+
+
+/// A library footprint placed as FOOTPRINT::FootprintNeedsUpdate() places it on an instance.
+/// The result has \a aBoard as parent: detach it (SetParent( nullptr )) before destroying it.
+std::unique_ptr<FOOTPRINT> placeLike( const FOOTPRINT& aLib, const FOOTPRINT& aInstance, BOARD* aBoard )
+{
+    std::unique_ptr<FOOTPRINT> placed( static_cast<FOOTPRINT*>( aLib.Clone() ) );
+    placed->SetParent( aBoard );
+
+    if( aInstance.IsFlipped() != placed->IsFlipped() )
+        placed->Flip( { 0, 0 }, FLIP_DIRECTION::TOP_BOTTOM );
+
+    placed->SetPosition( aInstance.GetPosition() );
+    placed->SetOrientation( aInstance.GetOrientation() );
+
+    for( BOARD_ITEM* item : placed->GraphicalItems() )
+        item->NormalizeForCompare();
+
+    return placed;
+}
+
+
+/// Whether \a aInstance matches \a aPlaced within IMPORT_TOLERANCE: same items (in any order),
+/// layers and texts, pads by number and position, zones. Fills \a aPadPairs when given.
+bool matchesWithin( const FOOTPRINT& aInstance, const FOOTPRINT& aPlaced, std::map<PAD*, PAD*>* aPadPairs )
+{
+    const auto& mine = aInstance.GraphicalItems();
+    const auto& theirs = aPlaced.GraphicalItems();
+
+    if( mine.size() != theirs.size() || aInstance.Pads().size() != aPlaced.Pads().size()
+        || aInstance.Zones().size() != aPlaced.Zones().size() )
+    {
+        return false;
+    }
+
+    std::vector<BOARD_ITEM*> unused( theirs.begin(), theirs.end() );
+
+    for( BOARD_ITEM* item : mine )
+    {
+        std::unique_ptr<BOARD_ITEM> normal( static_cast<BOARD_ITEM*>( item->Clone() ) );
+        normal->NormalizeForCompare();
+
+        auto it = std::find_if( unused.begin(), unused.end(),
+                                [&]( BOARD_ITEM* aOther ) { return sameWithin( normal.get(), aOther ); } );
+
+        if( it == unused.end() )
+            return false;
+
+        unused.erase( it );
+    }
+
+    std::vector<PAD*> unusedPads( aPlaced.Pads().begin(), aPlaced.Pads().end() );
+
+    for( PAD* a : aInstance.Pads() )
+    {
+        // The pad takes the library pad's position and orientation (takeGeometry()); everything
+        // else the library parity check compares must already agree. Altium may store a
+        // symmetric pad turned by 180 degrees: the same copper, so a different orientation is
+        // accepted when the pad outlines are the same shape.
+        auto sameOutline = [&]( const PAD* x, const PAD* y )
+        {
+            PCB_LAYER_ID layer = x->GetLayerSet().ExtractLayer();
+
+            if( layer == UNDEFINED_LAYER || !IsCopperLayer( layer ) )
+                layer = F_Cu;
+
+            const std::shared_ptr<SHAPE_POLY_SET>& px = x->GetEffectivePolygon( layer, ERROR_INSIDE );
+            const std::shared_ptr<SHAPE_POLY_SET>& py = y->GetEffectivePolygon( layer, ERROR_INSIDE );
+            SHAPE_POLY_SET                         difference;
+            difference.BooleanXor( *px, *py );
+
+            double perimeter = 0.0;
+
+            for( int o = 0; o < px->OutlineCount(); ++o )
+                perimeter += px->COutline( o ).Length();
+
+            return difference.Area() <= 2.0 * ARC_HIGH_DEF * perimeter;
+        };
+
+        auto it = std::find_if( unusedPads.begin(), unusedPads.end(),
+                                [&]( PAD* b )
+                                {
+                                    if( a->GetNumber() != b->GetNumber()
+                                        || !nearPt( a->GetPosition(), b->GetPosition() ) )
+                                    {
+                                        return false;
+                                    }
+
+                                    std::unique_ptr<PAD> moved( static_cast<PAD*>( a->Clone() ) );
+                                    moved->SetPosition( b->GetPosition() );
+                                    moved->SetOrientation( b->GetOrientation() );
+
+                                    // Both ways: the check walks only the first pad's layers
+                                    if( padNeedsUpdate( moved.get(), b, nullptr )
+                                        || padNeedsUpdate( b, moved.get(), nullptr ) )
+                                    {
+                                        return false;
+                                    }
+
+                                    return a->GetOrientation() == b->GetOrientation() || sameOutline( a, b );
+                                } );
+
+        if( it == unusedPads.end() )
+            return false;
+
+        if( aPadPairs )
+            ( *aPadPairs )[a] = *it;
+
+        unusedPads.erase( it );
+    }
+
+    // Keepouts drawn as tracks and arcs become polygons in each placement's own orientation, so
+    // their arc approximations differ: compare zones as shapes, to the approximation error.
+    for( size_t i = 0; i < aInstance.Zones().size(); ++i )
+    {
+        const ZONE* a = aInstance.Zones()[i];
+        const ZONE* b = aPlaced.Zones()[i];
+
+        if( a->GetLayerSet() != b->GetLayerSet() || a->GetIsRuleArea() != b->GetIsRuleArea() )
+            return false;
+
+        SHAPE_POLY_SET difference;
+        difference.BooleanXor( *a->Outline(), *b->Outline() );
+
+        double perimeter = 0.0;
+
+        for( int o = 0; o < a->Outline()->OutlineCount(); ++o )
+            perimeter += a->Outline()->COutline( o ).Length();
+
+        if( difference.Area() > 2.0 * ARC_HIGH_DEF * perimeter )
+            return false;
+    }
+
+    return true;
+}
+
+
+/// Give \a aInstance the geometry of \a aPlaced (which matches it within tolerance).
+void takeGeometry( FOOTPRINT& aInstance, const FOOTPRINT& aPlaced, const std::map<PAD*, PAD*>& aPadPairs )
+{
+    std::vector<BOARD_ITEM*> old( aInstance.GraphicalItems().begin(), aInstance.GraphicalItems().end() );
+
+    for( BOARD_ITEM* item : old )
+    {
+        aInstance.Remove( item );
+        delete item;
+    }
+
+    for( BOARD_ITEM* item : aPlaced.GraphicalItems() )
+    {
+        BOARD_ITEM* copy = static_cast<BOARD_ITEM*>( item->Clone() );
+        const_cast<KIID&>( copy->m_Uuid ) = KIID();
+        aInstance.Add( copy, ADD_MODE::APPEND );
+    }
+
+    for( const auto& [mine, theirs] : aPadPairs )
+    {
+        mine->SetPosition( theirs->GetPosition() );
+        mine->SetOrientation( theirs->GetOrientation() );
+    }
+
+    for( size_t i = 0; i < aInstance.Zones().size(); ++i )
+        *aInstance.Zones()[i]->Outline() = *aPlaced.Zones()[i]->Outline();
+}
+
+
+/**
+ * An Altium board can hold different footprints under one name (library revisions, parts
+ * edited on the board). Group the placed footprints of each name by what they are, within
+ * IMPORT_TOLERANCE; the largest group keeps the name and the others become "<name> (2)", ...
+ * Returns one definition per resulting name, for the library reconciliation.
+ */
+std::vector<std::unique_ptr<FOOTPRINT>> splitFootprintVariants( BOARD* aBoard, REPORTER& aReporter )
+{
+    std::map<wxString, std::vector<FOOTPRINT*>> byName;
+
+    for( FOOTPRINT* fp : aBoard->Footprints() )
+    {
+        wxString name = fp->GetFPID().GetUniStringLibItemName();
+
+        if( !name.IsEmpty() )
+            byName[name].push_back( fp );
+    }
+
+    // Front-side, unrotated copies make the cleanest definitions: consider them first
+    auto rank = []( const FOOTPRINT* aFp )
+    {
+        return ( aFp->IsFlipped() ? 2 : 0 ) + ( aFp->GetOrientation().IsZero() ? 0 : 1 );
+    };
+
+    std::vector<std::unique_ptr<FOOTPRINT>> definitions;
+
+    for( auto& [name, instances] : byName )
+    {
+        std::stable_sort( instances.begin(), instances.end(),
+                          [&]( FOOTPRINT* a, FOOTPRINT* b ) { return rank( a ) < rank( b ); } );
+
+        struct GROUP
+        {
+            std::unique_ptr<FOOTPRINT> definition; // library form
+            std::vector<FOOTPRINT*>    members;
+        };
+
+        std::vector<GROUP> groups;
+
+        for( FOOTPRINT* fp : instances )
+        {
+            GROUP* home = nullptr;
+
+            for( GROUP& group : groups )
+            {
+                std::unique_ptr<FOOTPRINT> placed = placeLike( *group.definition, *fp, aBoard );
+                bool                       same = matchesWithin( *fp, *placed, nullptr );
+                placed->SetParent( nullptr );
+
+                if( same )
+                {
+                    home = &group;
+                    break;
+                }
+            }
+
+            if( !home )
+            {
+                groups.push_back( { libraryForm( *fp ), {} } );
+                home = &groups.back();
+            }
+
+            home->members.push_back( fp );
+        }
+
+        std::stable_sort( groups.begin(), groups.end(),
+                          []( const GROUP& a, const GROUP& b ) { return a.members.size() > b.members.size(); } );
+
+        for( size_t g = 0; g < groups.size(); ++g )
+        {
+            wxString groupName = g == 0 ? name : wxString::Format( wxS( "%s (%zu)" ), name, g + 1 );
+
+            for( FOOTPRINT* fp : groups[g].members )
+            {
+                LIB_ID id = fp->GetFPID();
+                id.SetLibItemName( groupName );
+                fp->SetFPID( id );
+            }
+
+            // Already in library form: saving then has nothing to turn or flip (it would flip
+            // by the user's flip direction, not the way the parity check flips)
+            definitions.push_back( libraryForm( *groups[g].members.front() ) );
+        }
+
+        if( groups.size() > 1 )
+        {
+            aReporter.Report( wxString::Format( _( "Footprint '%s' is placed in %zu different forms; "
+                                                   "each has its own library entry." ),
+                                                name, groups.size() ),
+                              RPT_SEVERITY_INFO );
+        }
+    }
+
+    return definitions;
+}
+
+
+/**
+ * An Altium board's project (a .PrjPcb next to it listing it) names the footprint libraries the
+ * board's parts come from. Copy them into the KiCad project and register them, as the interactive
+ * project import does, so placed footprints link to them.
+ */
+void registerAltiumBoardLibraries( const wxFileName& aBoardFile, const wxString& aProjectDir,
+                                   REPORTER& aReporter )
+{
+    // The project usually sits next to the board, sometimes one folder up
+    std::vector<wxFileName> candidates;
+    wxFileName              board( aBoardFile );
+    board.MakeAbsolute(); // wxFileConfig reads a relative path from the user's home folder
+    wxFileName              parent( board.GetPath(), wxEmptyString );
+    parent.RemoveLastDir();
+
+    for( const wxString& folder : { board.GetPath(), parent.GetPath() } )
+    {
+        wxDir    dir( folder );
+        wxString name;
+
+        for( bool more = dir.IsOpened() && dir.GetFirst( &name, wxS( "*" ), wxDIR_FILES ); more;
+             more = dir.GetNext( &name ) )
+        {
+            if( wxFileName( name ).GetExt().CmpNoCase( wxS( "PrjPcb" ) ) == 0 )
+                candidates.emplace_back( folder, name );
+        }
+    }
+
+    for( const wxFileName& prjFn : candidates )
+    {
+
+        wxFileConfig config( wxEmptyString, wxEmptyString, wxEmptyString, prjFn.GetFullPath(),
+                             wxCONFIG_USE_NO_ESCAPE_CHARACTERS );
+
+        std::vector<wxFileName> libs;
+        bool                    listsBoard = false;
+        wxString                group;
+        long                    index;
+
+        for( bool g = config.GetFirstGroup( group, index ); g; g = config.GetNextGroup( group, index ) )
+        {
+            if( !group.StartsWith( wxS( "Document" ) ) )
+                continue;
+
+            wxFileName fn( config.Read( group + wxS( "/DocumentPath" ), wxEmptyString ), wxPATH_WIN );
+
+            if( fn.GetFullName().CmpNoCase( board.GetFullName() ) == 0 )
+                listsBoard = true;
+
+            wxString ext = fn.GetExt().Lower();
+
+            if( ext == wxS( "pcblib" ) || ext == wxS( "intlib" ) )
+            {
+                if( !fn.IsAbsolute() )
+                    fn.MakeAbsolute( prjFn.GetPath() );
+
+                libs.push_back( fn );
+            }
+        }
+
+        if( !listsBoard )
+            continue;
+
+        std::optional<LIBRARY_TABLE*> table =
+                Pgm().GetLibraryManager().Table( LIBRARY_TABLE_TYPE::FOOTPRINT, LIBRARY_TABLE_SCOPE::PROJECT );
+
+        if( !table )
+            return;
+
+        for( const wxFileName& lib : libs )
+        {
+            if( !lib.FileExists() || lib.GetSize() == 0 )
+                continue;
+
+            wxFileName copy( aProjectDir, lib.GetFullName() );
+
+            if( copy.GetFullPath() != lib.GetFullPath() )
+                wxCopyFile( lib.GetFullPath(), copy.GetFullPath(), true );
+
+            if( !( *table )->HasRow( lib.GetName() ) )
+            {
+                LIBRARY_TABLE_ROW& row = ( *table )->InsertRow();
+                row.SetNickname( lib.GetName() );
+                row.SetURI( wxS( "${KIPRJMOD}/" ) + lib.GetFullName() );
+                row.SetType( PCB_IO_MGR::ShowType( PCB_IO_MGR::ALTIUM_DESIGNER ) );
+            }
+        }
+
+        ( *table )->Save().map_error(
+                [&]( const LIBRARY_ERROR& aError )
+                {
+                    aReporter.Report( _( "Error saving project library table: " ) + aError.message,
+                                      RPT_SEVERITY_ERROR );
+                } );
+        return;
+    }
+}
+
+
+/**
+ * Give every placed footprint that matches its library footprint within IMPORT_TOLERANCE the
+ * library geometry, placed exactly as the parity check places it. A footprint linked to one of
+ * the project's own libraries whose library version differs from what is placed (a library
+ * changed since, or one KiCad reads with other layer meanings than the board's) is put in the
+ * import library instead, as placed, the way symbols are. Returns how many changed.
+ */
+int conformFootprintsToLibrary( BOARD* aBoard, FOOTPRINT_LIBRARY_ADAPTER& aAdapter,
+                                const wxString& aCacheNickname, const wxString& aCachePath,
+                                REPORTER& aReporter )
+{
+    std::map<wxString, std::unique_ptr<FOOTPRINT>> libraryFootprints;
+
+    auto libraryFor = [&]( const LIB_ID& aId ) -> const FOOTPRINT*
+    {
+        wxString key = aId.Format().wx_str();
+
+        if( !libraryFootprints.count( key ) )
+        {
