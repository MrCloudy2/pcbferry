+/**
+ * Footprint library ids by reference, read from a KiCad board file. Altium's board is where its
+ * footprints live, so once the board is imported, symbols take their footprint from it.
+ */
+std::map<wxString, wxString> boardFootprintsByReference( const wxString& aBoardFile )
+{
+    std::map<wxString, wxString> out;
+    wxFFile                      file( aBoardFile, wxS( "rb" ) );
+    wxString                     text;
+
+    if( !file.IsOpened() || !file.ReadAll( &text, wxConvUTF8 ) )
+        return out;
+
+    // A quoted S-expression string starting at aPos (just after the opening quote)
+    auto readString = [&]( size_t aPos ) -> wxString
+    {
+        wxString value;
+
+        for( size_t i = aPos; i < text.length(); ++i )
+        {
+            wxUniChar c = text[i];
+
+            if( c == '\\' && i + 1 < text.length() )
+                value += text[++i];
+            else if( c == '"' )
+                break;
+            else
+                value += c;
+        }
+
+        return value;
+    };
+
+    const wxString footprintTag = wxS( "\n\t(footprint \"" );
+    const wxString referenceTag = wxS( "(property \"Reference\" \"" );
+    size_t         pos = text.find( footprintTag );
+
+    while( pos != wxString::npos )
+    {
+        size_t   idStart = pos + footprintTag.length();
+        wxString fpid = readString( idStart );
+        size_t   next = text.find( footprintTag, idStart );
+        size_t   ref = text.find( referenceTag, idStart );
+
+        if( ref != wxString::npos && ( next == wxString::npos || ref < next ) )
+        {
+            wxString reference = readString( ref + referenceTag.length() );
+
+            if( !reference.IsEmpty() )
+                out.emplace( reference, fpid );
+        }
+
+        pos = next;
+    }
+
+    return out;
+}
 } // namespace
 
 
