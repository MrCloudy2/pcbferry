+
+    auto matchesLibrary = [&]( FOOTPRINT* aFp, const FOOTPRINT* aLib, std::map<PAD*, PAD*>* aPairs )
+    {
+        if( !aFp->FootprintNeedsUpdate( aLib, BOARD_ITEM::COMPARE_FLAGS::DRC ) )
+            return true;
+
+        std::unique_ptr<FOOTPRINT> placed = placeLike( *aLib, *aFp, aBoard );
+        bool                       same = matchesWithin( *aFp, *placed, aPairs );
+        placed->SetParent( nullptr );
+        return same;
+    };
