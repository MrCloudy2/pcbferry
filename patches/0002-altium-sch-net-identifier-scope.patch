+ALTIUM_NET_SCOPE ParseAltiumNetIdentifierScope( const wxString& aPrjPcbPath )
+{
+    wxFileConfig config( wxEmptyString, wxEmptyString, wxEmptyString, aPrjPcbPath,
+                         wxCONFIG_USE_NO_ESCAPE_CHARACTERS );
+
+    long mode = 0;
+    config.Read( wxS( "Design/HierarchyMode" ), &mode, 0 );
+
+    if( mode < static_cast<long>( ALTIUM_NET_SCOPE::AUTOMATIC )
+        || mode > static_cast<long>( ALTIUM_NET_SCOPE::STRICT_HIERARCHICAL ) )
+    {
+        return ALTIUM_NET_SCOPE::AUTOMATIC;
+    }
+
+    return static_cast<ALTIUM_NET_SCOPE>( mode );
+}
