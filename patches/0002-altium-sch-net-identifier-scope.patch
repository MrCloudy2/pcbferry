+/**
+ * Altium's "Net Identifier Scope": which net names connect across sheets. Stored as
+ * HierarchyMode in the [Design] section of a .PrjPcb.
+ */
+enum class ALTIUM_NET_SCOPE
+{
+    AUTOMATIC = 0,          ///< Resolved from the design: hierarchical if any sheet entries,
+                            ///<   else flat if any ports, else global
+    FLAT = 1,               ///< Ports are global; net labels are local to their sheet
+    HIERARCHICAL = 2,       ///< Ports connect only through sheet entries
+    GLOBAL = 3,             ///< Net labels and ports are global
+    STRICT_HIERARCHICAL = 4 ///< As hierarchical, with power ports local too
+};
+
+
+/**
+ * Read the net identifier scope of an Altium .PrjPcb project file.
+ *
+ * @param aPrjPcbPath Full path to the .PrjPcb file.
+ * @return The stored scope, or AUTOMATIC when it is missing or not recognised.
+ */
+ALTIUM_NET_SCOPE ParseAltiumNetIdentifierScope( const wxString& aPrjPcbPath );
+
