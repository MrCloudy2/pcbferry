+            int changed = 0;
+
+            auto removeUnused = [&]( PADSTACK& aPadstack )
+            {
+                // A via Altium already strips harder (its end layers too) keeps that.
+                if( aPadstack.UnconnectedLayerMode() == UNCONNECTED_LAYER_MODE::KEEP_ALL )
+                {
+                    aPadstack.SetUnconnectedLayerMode( UNCONNECTED_LAYER_MODE::REMOVE_EXCEPT_START_AND_END );
+                    ++changed;
+                }
+            };
+
+            for( FOOTPRINT* fp : board->Footprints() )
+            {
+                for( PAD* pad : fp->Pads() )
+                {
+                    if( pad->GetAttribute() == PAD_ATTRIB::PTH )
+                        removeUnused( pad->Padstack() );
+                }
+            }
+
+            for( PCB_TRACK* track : board->Tracks() )
+            {
+                if( track->Type() == PCB_VIA_T )
+                    removeUnused( static_cast<PCB_VIA*>( track )->Padstack() );
+            }
+
+            importMessages.Report( wxString::Format( _( "Unused inner lands removed on %d pads "
+                                                        "and vias." ), changed ),
+                                   RPT_SEVERITY_INFO );
+        }
+
         if( project )
