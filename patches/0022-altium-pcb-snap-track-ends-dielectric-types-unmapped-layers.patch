+void ALTIUM_PCB::HelperSnapTrackEnds()
+{
+    // Altium stores an arc by centre, radius and angles, so its ends land a few nanometres off
+    // the track or arc it continues, and KiCad connects arcs only where ends coincide (Kasli:
+    // hundreds of unconnected meander arcs). Ends that nearly meet on one layer and net are
+    // pulled onto one point: a via centre if there is one, else a straight track's end (exact
+    // in the file), else the earlier arc's end.
+    constexpr int TOL = 10000; // 10 um: well inside any track width, so nothing new connects
+
+    struct ANCHOR
+    {
+        VECTOR2I   pos;
+        int        rank;   // 0 via, 1 track end, 2 arc end
+        size_t     order;
+        PCB_TRACK* track;  // nullptr for a via
+        bool       start;
+    };
+
+    std::map<std::tuple<int, int, int64_t, int64_t>, std::vector<size_t>> grid;
+    std::vector<ANCHOR>                                                 anchors;
+
+    auto cell = []( int v ) { return static_cast<int64_t>( std::floor( v / double( TOL ) ) ); };
+
+    auto add = [&]( const ANCHOR& a, PCB_LAYER_ID aLayer, int aNet )
+    {
+        grid[{ aLayer, aNet, cell( a.pos.x ), cell( a.pos.y ) }].push_back( anchors.size() );
+        anchors.push_back( a );
+    };
+
+    std::vector<std::pair<size_t, std::pair<PCB_LAYER_ID, int>>> ends;
+
+    for( PCB_TRACK* track : m_board->Tracks() )
+    {
+        if( track->Type() == PCB_VIA_T )
+        {
+            for( PCB_LAYER_ID layer : LSET( track->GetLayerSet() & LSET::AllCuMask() ).Seq() )
+                add( { track->GetPosition(), 0, anchors.size(), nullptr, false }, layer, track->GetNetCode() );
+
+            continue;
+        }
+
+        int rank = track->Type() == PCB_ARC_T ? 2 : 1;
+
+        for( bool start : { true, false } )
+        {
+            ends.push_back( { anchors.size(), { track->GetLayer(), track->GetNetCode() } } );
+            add( { start ? track->GetStart() : track->GetEnd(), rank, anchors.size(), track, start },
+                 track->GetLayer(), track->GetNetCode() );
+        }
+    }
+
+    int snapped = 0;
+
+    for( const auto& [idx, key] : ends )
+    {
+        const ANCHOR& me = anchors[idx];
+        const ANCHOR* best = nullptr;
+
+        for( int64_t dx = -1; dx <= 1; ++dx )
+        {
+            for( int64_t dy = -1; dy <= 1; ++dy )
+            {
+                auto it = grid.find( { key.first, key.second, cell( me.pos.x ) + dx, cell( me.pos.y ) + dy } );
+
+                if( it == grid.end() )
+                    continue;
+
+                for( size_t j : it->second )
+                {
+                    const ANCHOR& other = anchors[j];
+
+                    if( other.track == me.track || ( other.pos - me.pos ).EuclideanNorm() > TOL )
+                        continue;
+
+                    // Only towards a better (lower rank, earlier) anchor, so no point moves twice
+                    if( std::tie( other.rank, other.order ) >= std::tie( me.rank, me.order ) )
+                        continue;
+
+                    if( !best || std::tie( other.rank, other.order ) < std::tie( best->rank, best->order ) )
+                        best = &other;
+                }
+            }
+        }
+
+        if( best && best->pos != me.pos )
+        {
+            if( me.start )
+                me.track->SetStart( best->pos );
+            else
+                me.track->SetEnd( best->pos );
+
+            ++snapped;
+        }
+    }
+
+    if( snapped && m_reporter )
+    {
+        m_reporter->Report( wxString::Format( _( "%d track and arc ends moved by less than 10 um "
+                                                 "to meet the copper they continue." ), snapped ),
+                            RPT_SEVERITY_INFO );
+    }
+}
