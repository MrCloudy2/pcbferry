         SCH_SCREEN* screen = new SCH_SCREEN( m_schematic );
         sheet->SetScreen( screen );
 
+        // As for single-file imports, the sheet takes its screen's UUID before anything is
+        // parsed into it. A saved top-level sheet is identified by its file's UUID, so symbol
+        // instance paths recorded under any other UUID don't resolve when the project is opened,
+        // which loses the per-channel references of sheets used more than once.
+        const_cast<KIID&>( sheet->m_Uuid ) = screen->GetUuid();
+
         // Convert to KiCad project-relative path with .kicad_sch extension
         kicad_fn.SetExt( FILEEXT::KiCadSchematicFileExtension );
