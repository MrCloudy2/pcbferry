+        // A loaded sheet's screen carries the KiCad file name it will be saved as, so look the
+        // file up under that name. Searching for the Altium file name never matched, and a
+        // sheet used by several sheet symbols (an Altium multichannel design) was parsed again
+        // for each, leaving each channel on its own screen with one symbol instance; saved under
+        // the same file name, only the last channel survived.
+        wxFileName projectFileName = loadAltiumFileName;
+        projectFileName.SetPath( m_schematic->Project().GetProjectPath() );
+        projectFileName.SetExt( FILEEXT::KiCadSchematicFileExtension );
+
+        if( auto it = m_loadedScreens.find( projectFileName.GetFullPath() ); it != m_loadedScreens.end() )
+            loadedScreen = it->second;
+        else
+            m_rootSheet->SearchHierarchy( projectFileName.GetFullPath(), &loadedScreen );
 
         if( loadedScreen )
         {
             sheet->SetScreen( loadedScreen );
