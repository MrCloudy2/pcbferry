+void SCH_IO_ALTIUM::ParseParameterSet( int aIndex, const std::map<wxString, wxString>& aProperties )
+{
+    ASCH_PARAMETER_SET elem( aProperties );
+
+    SCH_SCREEN* screen = getCurrentScreen();
+    wxCHECK( screen, /* void */ );
+
+    SCH_DIRECTIVE_LABEL* label = new SCH_DIRECTIVE_LABEL( elem.location + m_sheetOffset );
+
+    switch( elem.orientation )
+    {
+    case ASCH_RECORD_ORIENTATION::RIGHTWARDS: label->SetSpinStyle( SPIN_STYLE::RIGHT );  break;
+    case ASCH_RECORD_ORIENTATION::UPWARDS:    label->SetSpinStyle( SPIN_STYLE::UP );     break;
+    case ASCH_RECORD_ORIENTATION::LEFTWARDS:  label->SetSpinStyle( SPIN_STYLE::LEFT );   break;
+    case ASCH_RECORD_ORIENTATION::DOWNWARDS:  label->SetSpinStyle( SPIN_STYLE::BOTTOM ); break;
+    }
+
+    // Altium shows the set's name (e.g. DIFFPAIR) by the flag
+    if( !elem.name.IsEmpty() )
+    {
+        SCH_FIELD field( label, FIELD_T::USER, wxT( "Parameter Set" ) );
+        field.SetText( elem.name );
+        field.SetVisible( true );
+        label->AddField( field );
+    }
+
+    label->SetFlags( IS_NEW );
+    screen->Append( label );
+    m_parameterSets[aIndex] = label;
+}
+
+
+void SCH_IO_ALTIUM::ParseBlanket( const std::map<wxString, wxString>& aProperties )
+{
+    ASCH_BLANKET elem( aProperties );
+
+    SCH_SCREEN* screen = getCurrentScreen();
+    wxCHECK( screen, /* void */ );
+
+    if( elem.points.size() < 3 )
+        return;
+
+    // A rule area applies the directive labels on its border to the nets inside, as a Blanket
+    SCH_RULE_AREA* area = new SCH_RULE_AREA();
+
+    for( const VECTOR2I& point : elem.points )
+        area->AddPoint( point + m_sheetOffset );
+
+    area->AddPoint( elem.points.front() + m_sheetOffset );
+    area->SetFlags( IS_NEW );
+    screen->Append( area );
+}
