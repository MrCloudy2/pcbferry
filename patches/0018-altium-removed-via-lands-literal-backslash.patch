@@ -4794,6 +4794,31 @@ void ALTIUM_PCB::ParseVias6Data( const ALTIUM_PCB_COMPOUND_FILE&     aAltiumPcbF
         }
         }
 
+        // Altium removes unused lands per layer; KiCad removes those not connected, which is
+        // what "Remove Unused Pad Shapes" computed.
+        int  spanStart = std::min( static_cast<int>( elem.layer_start ), static_cast<int>( elem.layer_end ) );
+        int  spanEnd = std::max( static_cast<int>( elem.layer_start ), static_cast<int>( elem.layer_end ) );
+        bool innerRemoved = false;
+        bool endRemoved = false;
+
+        for( int altiumLayer = spanStart; altiumLayer <= spanEnd && altiumLayer <= 32; ++altiumLayer )
+        {
+            if( altiumLayer < 1 || !elem.is_pad_removed[altiumLayer - 1] )
+                continue;
+
+            if( altiumLayer == spanStart || altiumLayer == spanEnd )
+                endRemoved = true;
+            else
+                innerRemoved = true;
+        }
+
+        if( innerRemoved || endRemoved )
+        {
+            via->Padstack().SetUnconnectedLayerMode(
+                    endRemoved ? UNCONNECTED_LAYER_MODE::REMOVE_ALL
+                               : UNCONNECTED_LAYER_MODE::REMOVE_EXCEPT_START_AND_END );
+        }
+
         // Altium can size the solder mask opening from the hole edge instead of the via land.
         // KiCad vias cannot represent a hole-referenced opening, so when the resulting opening
         // does not clear the via land the pad copper is covered and the via is effectively tented.
