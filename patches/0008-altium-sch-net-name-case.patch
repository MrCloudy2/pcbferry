+// Altium compares net names without regard to case ("RX signal" and "RX SIGNAL" are one net);
+// KiCad does not. Give every net label, port and sheet pin that differs only in case the
+// spelling met first. Labels holding harness groups are left alone.
+static void unifyNetNameCase( const std::vector<SCH_SHEET*>& aTopSheets )
+{
+    std::vector<SCH_TEXT*>       named;
+    std::set<SCH_SCREEN*>        seen;
+
+    for( SCH_SHEET* top : aTopSheets )
+    {
+        SCH_SCREENS screens( top );
+
+        for( SCH_SCREEN* screen = screens.GetFirst(); screen; screen = screens.GetNext() )
+        {
+            if( !seen.insert( screen ).second )
+                continue;
+
+            for( SCH_ITEM* item : screen->Items() )
+            {
+                switch( item->Type() )
+                {
+                case SCH_LABEL_T:
+                case SCH_GLOBAL_LABEL_T:
+                case SCH_HIER_LABEL_T:
+                    named.push_back( static_cast<SCH_TEXT*>( item ) );
+                    break;
+
+                case SCH_SHEET_T:
+                    for( SCH_SHEET_PIN* pin : static_cast<SCH_SHEET*>( item )->GetPins() )
+                        named.push_back( pin );
+
+                    break;
+
+                default:
+                    break;
+                }
+            }
+        }
+    }
+
+    std::map<wxString, wxString> spelling;
+
+    for( SCH_TEXT* text : named )
+    {
+        if( text->GetText().Contains( wxT( "{" ) ) )
+            continue;
+
+        spelling.try_emplace( text->GetText().Upper(), text->GetText() );
+    }
+
+    for( SCH_TEXT* text : named )
+    {
+        if( text->GetText().Contains( wxT( "{" ) ) )
+            continue;
+
+        const wxString& canonical = spelling[text->GetText().Upper()];
+
+        if( canonical != text->GetText() )
+            text->SetText( canonical );
+    }
+}
+
+
