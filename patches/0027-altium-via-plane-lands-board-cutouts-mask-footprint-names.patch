+// Internal layers of the board that are Altium planes (imported as power layers)
+static LSET altiumPlaneLayers( const BOARD* aBoard )
+{
+    LSET planes;
+
+    for( PCB_LAYER_ID layer : LSET( aBoard->GetEnabledLayers() & LSET::InternalCuMask() ).Seq() )
+    {
+        if( aBoard->GetLayerType( layer ) == LT_POWER )
+            planes.set( layer );
+    }
+
+    return planes;
+}
+
+
+// Give a padstack its own shape per copper layer, with a land exactly the size of the hole on
+// the plane layers: no copper ring, and KiCad's clearances measured from the hole, as Altium's.
+static void holeSizedLandsOnPlanes( PADSTACK& aPadstack, const LSET& aLayers, const LSET& aPlanes,
+                                    const VECTOR2I& aDrill, bool aOblong )
+{
+    std::vector<std::pair<PCB_LAYER_ID, PADSTACK::COPPER_LAYER_PROPS>> props;
+
+    for( PCB_LAYER_ID layer : LSET( aLayers & LSET::AllCuMask() ).Seq() )
+        props.emplace_back( layer, aPadstack.CopperLayer( aPadstack.EffectiveLayerFor( layer ) ) );
+
+    aPadstack.SetMode( PADSTACK::MODE::CUSTOM );
+
+    for( const auto& [layer, layerProps] : props )
+    {
+        aPadstack.CopperLayer( layer ) = layerProps;
+
+        if( aPlanes.test( layer ) )
+        {
+            aPadstack.SetShape( aOblong ? PAD_SHAPE::OVAL : PAD_SHAPE::CIRCLE, layer );
+            aPadstack.SetSize( aOblong ? aDrill : VECTOR2I( aDrill.x, aDrill.x ), layer );
+            aPadstack.Offset( layer ) = VECTOR2I( 0, 0 );
+        }
+    }
+}
