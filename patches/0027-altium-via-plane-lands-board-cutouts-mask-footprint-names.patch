+void ALTIUM_PCB::HelperApplyBoardCutouts()
+{
+    // Altium removes a board cutout from the board shape. One wholly inside the board is a hole
+    // in KiCad's outline; one that crosses the board edge (or lies outside it) would leave
+    // overlapping loops on Edge.Cuts, so it is subtracted from the outline instead.
+    SHAPE_POLY_SET board;
+
+    if( m_boardOutline.PointCount() >= 3 )
+    {
+        SHAPE_LINE_CHAIN outline = m_boardOutline;
+        outline.SetClosed( true );
+        board.AddOutline( outline );
+    }
+
+    SHAPE_POLY_SET crossing;
+
+    for( SHAPE_LINE_CHAIN& cutout : m_boardCutouts )
+    {
+        if( cutout.PointCount() < 3 )
+            continue;
+
+        cutout.SetClosed( true );
+        SHAPE_LINE_CHAIN::INTERSECTIONS hits;
+        bool inside = !board.IsEmpty() && cutout.Intersect( m_boardOutline, hits ) == 0;
+
+        for( int i = 0; inside && i < cutout.PointCount(); ++i )
+            inside = board.Contains( cutout.CPoint( i ) );
+
+        if( inside || board.IsEmpty() )
+            HelperCreateEdgeCutsFromChain( cutout );
+        else
+            crossing.AddOutline( cutout );
+    }
+
+    if( crossing.IsEmpty() )
+        return;
+
+    board.BooleanSubtract( crossing );
+
+    for( PCB_SHAPE* shape : m_boardOutlineShapes )
+    {
+        m_board->Remove( shape );
+        delete shape;
+    }
+
+    m_boardOutlineShapes.clear();
+
+    for( int ii = 0; ii < board.OutlineCount(); ++ii )
+    {
+        HelperCreateEdgeCutsFromChain( board.Outline( ii ) );
+
+        for( int jj = 0; jj < board.HoleCount( ii ); ++jj )
+            HelperCreateEdgeCutsFromChain( board.Hole( ii, jj ) );
     }
 }
 
