+/**
+ * Copy the libraries an Altium project lists into the KiCad project and register them in its
+ * symbol and footprint tables, as the interactive project import does: schematic symbols then
+ * link to their library, and footprint fields can be reconciled. Returns the footprint library
+ * nicknames.
+ */
+std::vector<wxString> registerAltiumProjectLibraries( const wxFileName& aPrjPcb, const wxString& aProjectDir,
+                                                      REPORTER& aReporter )
+{
+    wxFileConfig config( wxEmptyString, wxEmptyString, wxEmptyString, aPrjPcb.GetFullPath(),
+                         wxCONFIG_USE_NO_ESCAPE_CHARACTERS );
+
+    std::vector<wxFileName> symLibs, fpLibs;
+    wxString                group;
+    long                    index;
+
+    for( bool more = config.GetFirstGroup( group, index ); more; more = config.GetNextGroup( group, index ) )
+    {
+        if( !group.StartsWith( wxS( "Document" ) ) )
+            continue;
+
+        wxFileName fn( config.Read( group + wxS( "/DocumentPath" ), wxEmptyString ), wxPATH_WIN );
+
+        if( !fn.IsOk() || fn.GetFullName().IsEmpty() )
+            continue;
+
+        if( !fn.IsAbsolute() )
+            fn.MakeAbsolute( aPrjPcb.GetPath() );
+
+        wxString ext = fn.GetExt().Lower();
+
+        if( ext == wxS( "schlib" ) || ext == wxS( "intlib" ) )
+            symLibs.push_back( fn );
+
+        if( ext == wxS( "pcblib" ) || ext == wxS( "intlib" ) )
+            fpLibs.push_back( fn );
+    }
+
+    LIBRARY_MANAGER&      manager = Pgm().GetLibraryManager();
+    std::vector<wxString> fpNicknames;
+
+    auto addRows = [&]( const std::vector<wxFileName>& aLibs, LIBRARY_TABLE_TYPE aType, const wxString& aPluginName,
+                        std::vector<wxString>* aNicknames )
+    {
+        std::optional<LIBRARY_TABLE*> table = manager.Table( aType, LIBRARY_TABLE_SCOPE::PROJECT );
+
+        if( !table || aLibs.empty() )
+            return;
+
+        for( const wxFileName& lib : aLibs )
+        {
+            if( !lib.FileExists() || lib.GetSize() == 0 )
+            {
+                aReporter.Report( wxString::Format( _( "Library '%s' listed in the project was not found or is empty." ),
+                                                    lib.GetFullPath() ),
+                                  RPT_SEVERITY_WARNING );
+                continue;
+            }
+
+            // Copy it into the project so the table stays portable, as the interactive import does
+            wxFileName copy( aProjectDir, lib.GetFullName() );
+
+            if( copy.GetFullPath() != lib.GetFullPath() )
+                wxCopyFile( lib.GetFullPath(), copy.GetFullPath(), true );
+
+            if( !( *table )->HasRow( lib.GetName() ) )
+            {
+                LIBRARY_TABLE_ROW& row = ( *table )->InsertRow();
+                row.SetNickname( lib.GetName() );
+                row.SetURI( wxS( "${KIPRJMOD}/" ) + lib.GetFullName() );
+                row.SetType( aPluginName );
+            }
+
+            if( aNicknames )
+                aNicknames->push_back( lib.GetName() );
+        }
+
+        ( *table )->Save().map_error(
+                [&]( const LIBRARY_ERROR& aError )
+                {
+                    aReporter.Report( _( "Error saving project library table: " ) + aError.message,
+                                      RPT_SEVERITY_ERROR );
+                } );
+    };
+
+    addRows( symLibs, LIBRARY_TABLE_TYPE::SYMBOL, SCH_IO_MGR::ShowType( SCH_IO_MGR::SCH_ALTIUM ), nullptr );
+    // The footprint plugin lives in pcbnew; its registered name is stable.
+    addRows( fpLibs, LIBRARY_TABLE_TYPE::FOOTPRINT, wxS( "Altium Designer" ), &fpNicknames );
+
+    return fpNicknames;
+}
