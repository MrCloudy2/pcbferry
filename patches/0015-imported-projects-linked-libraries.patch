+    // (mechanical layer pairs, rounding), which then reads as a library mismatch.
+    auto rank = []( const FOOTPRINT* aFp )
+    {
+        return ( aFp->IsFlipped() ? 2 : 0 ) + ( aFp->GetOrientation().IsZero() ? 0 : 1 );
+    };
