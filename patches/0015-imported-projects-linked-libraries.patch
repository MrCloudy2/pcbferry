+/**
+ * Link every imported symbol to a library, as the board import does for footprints: a symbol
+ * found in a registered project library (e.g. a copied SchLib) keeps its link; the others (from
+ * database or server libraries the import cannot read) are written, from the schematic's own
+ * copies, to a "<project>-import-syms" library that is registered in the project and linked.
+ */
+void linkImportedSymbols( SCHEMATIC& aSchematic, PROJECT* aProject, const wxString& aCacheNickname,
+                          REPORTER& aReporter )
+{
+    SYMBOL_LIBRARY_ADAPTER* adapter = PROJECT_SCH::SymbolLibAdapter( aProject );
+    std::set<wxString>      loaded;
+
+    constexpr int sameFlags = SCH_ITEM::COMPARE_FLAGS::EQUALITY | SCH_ITEM::COMPARE_FLAGS::ERC;
+
+    // Linked to its source library only if the library holds the same symbol: a placed part can
+    // differ from its library (edited, or an older library revision), and the design must not
+    // change when the project is opened.
+    auto inLibrary = [&]( const LIB_ID& aId, const LIB_SYMBOL& aPlaced ) -> bool
+    {
+        wxString nick = aId.GetUniStringLibNickname();
+
+        if( !adapter || nick.IsEmpty() || nick == aCacheNickname )
+            return false;
+
+        try
+        {
+            if( loaded.insert( nick ).second )
+                adapter->LoadOne( nick );
+
+            LIB_SYMBOL* libSymbol = adapter->LoadSymbol( nick, aId.GetUniStringLibItemName() );
+
+            return libSymbol && libSymbol->Flatten()->Compare( aPlaced, sameFlags ) == 0;
+        }
+        catch( const std::exception& )
+        {
+            return false;
+        }
+        catch( const IO_ERROR& )
+        {
+            return false;
+        }
+    };
+
+    // Altium parts that share a library name can still differ (database records with their own
+    // graphics), so each distinct definition gets its own name: "<name>", "<name> (2)", ...
+
+    std::map<wxString, std::unique_ptr<LIB_SYMBOL>>  cache;      // name -> definition
+    std::map<wxString, std::vector<wxString>>        namesByKey; // old lib id -> names made for it
+    std::map<SCH_SYMBOL*, wxString>                  newName;    // symbol -> name in the cache
+    SCH_SCREENS                                      screens( aSchematic.Root() );
+
+    for( SCH_SCREEN* screen = screens.GetFirst(); screen; screen = screens.GetNext() )
+    {
+        for( SCH_ITEM* item : screen->Items().OfType( SCH_SYMBOL_T ) )
+        {
+            SCH_SYMBOL* symbol = static_cast<SCH_SYMBOL*>( item );
+            LIB_ID      id = symbol->GetLibId();
+            wxString    key = id.Format().wx_str();
+
+            if( !symbol->GetLibSymbolRef() )
+                continue;
+
+            std::unique_ptr<LIB_SYMBOL> flat = symbol->GetLibSymbolRef()->Flatten();
+
+            if( inLibrary( id, *flat ) )
+                continue;
+            wxString                    name;
+
+            for( const wxString& candidate : namesByKey[key] )
+            {
+                if( cache[candidate]->Compare( *flat, sameFlags ) == 0 )
+                {
+                    name = candidate;
+                    break;
+                }
+            }
+
+            if( name.IsEmpty() )
+            {
+                wxString base = id.GetUniStringLibItemName();
+
+                if( cache.count( base ) )
+                    base = wxString::Format( wxS( "%s (%s)" ), base, id.GetUniStringLibNickname() );
+
+                name = base;
+
+                for( int n = 2; cache.count( name ); ++n )
+                    name = wxString::Format( wxS( "%s (%d)" ), base, n );
+
+                flat->SetName( name );
+                flat->SetLibId( LIB_ID( aCacheNickname, name ) );
+                cache[name] = std::move( flat );
+                namesByKey[key].push_back( name );
+            }
+
+            newName[symbol] = name;
+        }
+    }
+
+    if( cache.empty() )
+        return;
+
+    wxFileName libFn( aProject->GetProjectPath(), aCacheNickname, FILEEXT::KiCadSymbolLibFileExtension );
+
+    try
+    {
+        IO_RELEASER<SCH_IO> io( SCH_IO_MGR::FindPlugin( SCH_IO_MGR::SCH_KICAD ) );
+
+        if( libFn.FileExists() )
+            wxRemoveFile( libFn.GetFullPath() );
+
+        io->CreateLibrary( libFn.GetFullPath() );
+
+        // The library cache takes ownership of what it is given
+        for( const auto& [name, definition] : cache )
+            io->SaveSymbol( libFn.GetFullPath(), new LIB_SYMBOL( *definition ) );
+
+        io->SaveLibrary( libFn.GetFullPath() );
+    }
+    catch( const IO_ERROR& ioe )
+    {
+        aReporter.Report( wxString::Format( _( "Could not write symbol library '%s': %s" ),
+                                            libFn.GetFullPath(), ioe.What() ),
+                          RPT_SEVERITY_WARNING );
+        return;
+    }
+
+    std::optional<LIBRARY_TABLE*> table = Pgm().GetLibraryManager().Table( LIBRARY_TABLE_TYPE::SYMBOL,
+                                                                           LIBRARY_TABLE_SCOPE::PROJECT );
+
+    if( !table )
+        return;
+
+    if( !( *table )->HasRow( aCacheNickname ) )
+    {
+        LIBRARY_TABLE_ROW& row = ( *table )->InsertRow();
+        row.SetNickname( aCacheNickname );
+        row.SetURI( wxS( "${KIPRJMOD}/" ) + libFn.GetFullName() );
+        row.SetType( SCH_IO_MGR::ShowType( SCH_IO_MGR::SCH_KICAD ) );
+    }
+
+    ( *table )->Save().map_error(
+            [&]( const LIBRARY_ERROR& aError )
+            {
+                aReporter.Report( _( "Error saving project library table: " ) + aError.message,
+                                  RPT_SEVERITY_ERROR );
+            } );
+
+    for( auto& [symbol, name] : newName )
+    {
+        // The schematic's own copy stays keyed as before (the key falls back to the library
+        // id, so pin it first); only the library link changes.
+        symbol->SetSchSymbolLibraryName( symbol->GetSchSymbolLibraryName() );
+        symbol->SetLibId( LIB_ID( aCacheNickname, name ) );
+    }
+}
