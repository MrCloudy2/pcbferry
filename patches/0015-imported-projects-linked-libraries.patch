+bool PCB_IO_ALTIUM_DESIGNER::FootprintExists( const wxString& aLibraryPath, const wxString& aFootprintName,
+                                              const std::map<std::string, UTF8>* aProperties )
+{
+    // The base implementation loads the footprint, which throws for a name the library lacks
+    // and leaks the one it finds.
+    wxArrayString names;
+
+    try
+    {
+        FootprintEnumerate( names, aLibraryPath, true, aProperties );
+    }
+    catch( const IO_ERROR& )
+    {
+        return false;
+    }
+
+    return names.Index( aFootprintName ) != wxNOT_FOUND;
+}
