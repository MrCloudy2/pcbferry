+// Altium sheet entries may carry no harness type while the port inside the sheet does. KiCad
+// pairs a sheet pin with the sheet's hierarchical label by exact text, so give an untyped
+// sheet pin the NAME{TYPE} text of its port.
+static void matchSheetPinsToHarnessPorts( SCH_SHEET* aTop )
+{
+    SCH_SCREENS screens( aTop );
+
+    for( SCH_SCREEN* screen = screens.GetFirst(); screen; screen = screens.GetNext() )
+    {
+        for( SCH_ITEM* item : screen->Items().OfType( SCH_SHEET_T ) )
+        {
+            SCH_SHEET*  sheet = static_cast<SCH_SHEET*>( item );
+            SCH_SCREEN* child = sheet->GetScreen();
+
+            if( !child )
+                continue;
+
+            std::map<wxString, wxString> typedPorts;
+
+            for( SCH_ITEM* label : child->Items().OfType( SCH_HIER_LABEL_T ) )
+            {
+                wxString text = static_cast<SCH_HIERLABEL*>( label )->GetText();
+
+                if( !text.StartsWith( wxT( "{" ) ) && text.Contains( wxT( "{" ) )
+                    && text.EndsWith( wxT( "}" ) ) )
+                {
+                    typedPorts[text.BeforeFirst( '{' )] = text;
+                }
+            }
+
+            for( SCH_SHEET_PIN* pin : sheet->GetPins() )
+            {
+                auto it = typedPorts.find( pin->GetText() );
+
+                if( it != typedPorts.end() )
+                    pin->SetText( it->second );
+            }
+        }
+    }
+}
