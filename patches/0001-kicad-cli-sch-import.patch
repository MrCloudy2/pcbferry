+#ifndef JOB_SCH_IMPORT_H
+#define JOB_SCH_IMPORT_H
+
+#include <kicommon.h>
+#include "job.h"
+
+/**
+ * Job to import a non-KiCad schematic to KiCad format.
+ *
+ * Supports the formats handled by the SCH_IO import plugins (Altium, Eagle, CADSTAR, ...).
+ * Sub-sheets referenced by the input are imported too and written next to the output file.
+ */
+class KICOMMON_API JOB_SCH_IMPORT : public JOB
+{
+public:
+    JOB_SCH_IMPORT();
+
+    wxString GetDefaultDescription() const override;
+    wxString GetSettingsDialogTitle() const override;
+
+    enum class FORMAT
+    {
+        AUTO,
+        ALTIUM,
+        CADSTAR,
+        EAGLE,
+        EASYEDA,
+        EASYEDAPRO,
+        GEDA,
+        LTSPICE,
+        PADS
+    };
+
+    enum class REPORT_FORMAT
+    {
+        NONE,
+        JSON,
+        TEXT
+    };
+
+    wxString      m_inputFile;
+    FORMAT        m_format = FORMAT::AUTO;
+    REPORT_FORMAT m_reportFormat = REPORT_FORMAT::NONE;
+    wxString      m_reportFile;
+};
+
+#endif
