+namespace
+{
+/**
+ * Keeps each message an importer reports, so they can go into the import report one by one.
+ */
+class COLLECTING_REPORTER : public REPORTER
+{
+public:
+    REPORTER& Report( const wxString& aText, SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED ) override
+    {
+        REPORTER::Report( aText, aSeverity );
+
+        wxString text = aText;
+        text.Trim( true ).Trim( false );
+
+        if( !text.IsEmpty() )
+            m_messages.emplace_back( text, aSeverity );
+
+        return *this;
+    }
+
+    std::vector<std::pair<wxString, SEVERITY>> m_messages;
+};
+
+
+SCH_IO_MGR::SCH_FILE_T importFileType( JOB_SCH_IMPORT::FORMAT aFormat, const wxString& aPath )
+{
+    switch( aFormat )
+    {
+    case JOB_SCH_IMPORT::FORMAT::AUTO:       return SCH_IO_MGR::GuessPluginTypeFromSchPath( aPath );
+    case JOB_SCH_IMPORT::FORMAT::ALTIUM:     return SCH_IO_MGR::SCH_ALTIUM;
+    case JOB_SCH_IMPORT::FORMAT::CADSTAR:    return SCH_IO_MGR::SCH_CADSTAR_ARCHIVE;
+    case JOB_SCH_IMPORT::FORMAT::EAGLE:      return SCH_IO_MGR::SCH_EAGLE;
+    case JOB_SCH_IMPORT::FORMAT::EASYEDA:    return SCH_IO_MGR::SCH_EASYEDA;
+    case JOB_SCH_IMPORT::FORMAT::EASYEDAPRO: return SCH_IO_MGR::SCH_EASYEDAPRO;
+    case JOB_SCH_IMPORT::FORMAT::GEDA:       return SCH_IO_MGR::SCH_GEDA;
+    case JOB_SCH_IMPORT::FORMAT::LTSPICE:    return SCH_IO_MGR::SCH_LTSPICE;
+    case JOB_SCH_IMPORT::FORMAT::PADS:       return SCH_IO_MGR::SCH_PADS;
+    }
+
+    return SCH_IO_MGR::SCH_FILE_UNKNOWN;
+}
+
+
+/**
+ * Resolve a document path from an Altium project. Projects come from Windows, so the stored
+ * case often differs from the file on disk.
+ */
+wxString resolveProjectDocument( const wxString& aProjectDir, const wxString& aStoredPath )
+{
+    wxFileName fn( aStoredPath, wxPATH_WIN );
+
+    if( !fn.IsAbsolute() )
+        fn.MakeAbsolute( aProjectDir );
+
+    if( fn.FileExists() )
+        return fn.GetFullPath();
+
+    wxDir    dir( fn.GetPath() );
+    wxString candidate;
+
+    if( dir.IsOpened() && dir.GetFirst( &candidate, wxEmptyString, wxDIR_FILES ) )
+    {
+        do
+        {
+            if( candidate.CmpNoCase( fn.GetFullName() ) == 0 )
+                return wxFileName( fn.GetPath(), candidate ).GetFullPath();
+        } while( dir.GetNext( &candidate ) );
+    }
+
+    return wxEmptyString;
+}
+
+
+/**
+ * Build the properties the Altium importer expects for a whole-project import: the project
+ * file and every schematic document it lists. This is what the interactive project import
+ * passes; it is also the only path that brings in Altium variants.
+ */
+std::map<std::string, UTF8> altiumProjectProperties( const wxFileName& aProjectFile,
+                                                     REPORTER& aReporter )
+{
+    std::map<std::string, UTF8> props;
+    props["project_file"] = aProjectFile.GetFullPath().ToStdString();
+
+    wxFFile file( aProjectFile.GetFullPath(), wxS( "rb" ) );
+    wxString text;
+
+    if( !file.IsOpened() || !file.ReadAll( &text, wxConvAuto() ) )
+        return props;
+
+    bool inDocument = false;
+    int  sheetIndex = 0;
+
+    for( wxString line : wxSplit( text, '\n', '\0' ) )
+    {
+        line.Trim( true ).Trim( false );
+
+        if( line.StartsWith( wxS( "[" ) ) )
+        {
+            inDocument = line.Upper().StartsWith( wxS( "[DOCUMENT" ) );
+            continue;
+        }
+
+        if( !inDocument || !line.Upper().StartsWith( wxS( "DOCUMENTPATH=" ) ) )
+            continue;
+
+        wxString stored = line.AfterFirst( '=' );
+
+        if( !wxFileName( stored, wxPATH_WIN ).GetExt().IsSameAs( wxS( "SchDoc" ), false ) )
+            continue;
+
+        wxString path = resolveProjectDocument( aProjectFile.GetPath(), stored );
+
+        if( path.IsEmpty() )
+        {
+            aReporter.Report( wxString::Format( _( "Schematic '%s' listed in the project was not "
+                                                   "found" ),
+                                                stored ),
+                              RPT_SEVERITY_WARNING );
+            continue;
+        }
+
+        props["sch" + std::to_string( sheetIndex++ )] = path.ToStdString();
+    }
+
+    return props;
+}
+} // namespace
+
+
+int EESCHEMA_JOBS_HANDLER::JobSchImport( JOB* aJob )
+{
+    JOB_SCH_IMPORT* job = dynamic_cast<JOB_SCH_IMPORT*>( aJob );
+
+    if( !job )
+        return CLI::EXIT_CODES::ERR_UNKNOWN;
+
+    wxFileName inputFn( job->m_inputFile );
+    inputFn.MakeAbsolute();
+
+    if( !inputFn.FileExists() )
+    {
+        m_reporter->Report( wxString::Format( _( "Input file not found: '%s'\n" ), job->m_inputFile ),
+                            RPT_SEVERITY_ERROR );
+        return CLI::EXIT_CODES::ERR_INVALID_INPUT_FILE;
+    }
+
+    const bool isAltiumProject = inputFn.GetExt().IsSameAs( wxS( "PrjPcb" ), false );
+
+    SCH_IO_MGR::SCH_FILE_T fileType = isAltiumProject ? SCH_IO_MGR::SCH_ALTIUM
+                                                      : importFileType( job->m_format,
+                                                                        inputFn.GetFullPath() );
+
+    if( fileType == SCH_IO_MGR::SCH_FILE_UNKNOWN || fileType == SCH_IO_MGR::SCH_KICAD
+        || fileType == SCH_IO_MGR::SCH_LEGACY )
+    {
+        m_reporter->Report( wxString::Format( _( "'%s' is not a schematic format that can be "
+                                                 "imported\n" ),
+                                              job->m_inputFile ),
+                            RPT_SEVERITY_ERROR );
+        return CLI::EXIT_CODES::ERR_INVALID_INPUT_FILE;
+    }
+
+    wxFileName outputFn( job->GetConfiguredOutputPath().IsEmpty() ? inputFn.GetFullPath()
+                                                                  : job->GetConfiguredOutputPath() );
+    outputFn.SetExt( FILEEXT::KiCadSchematicFileExtension );
+    outputFn.MakeAbsolute();
+
+    if( !outputFn.DirExists() && !wxFileName::Mkdir( outputFn.GetPath(), wxS_DIR_DEFAULT,
+                                                     wxPATH_MKDIR_FULL ) )
+    {
+        m_reporter->Report( wxString::Format( _( "Could not create directory '%s'\n" ),
+                                              outputFn.GetPath() ),
+                            RPT_SEVERITY_ERROR );
+        return CLI::EXIT_CODES::ERR_INVALID_OUTPUT_CONFLICT;
+    }
+
+    // Importers place sub-sheets in the project folder, so the project must live next to the
+    // output before anything is loaded.
+    wxFileName proFn( outputFn );
+    proFn.SetExt( FILEEXT::ProjectFileExtension );
+
+    SETTINGS_MANAGER& mgr = Pgm().GetSettingsManager();
+    mgr.LoadProject( proFn.GetFullPath(), true );
+    PROJECT* project = mgr.GetProject( proFn.GetFullPath() );
+
+    if( !project )
+    {
+        m_reporter->Report( wxString::Format( _( "Could not create project '%s'\n" ),
+                                              proFn.GetFullPath() ),
+                            RPT_SEVERITY_ERROR );
+        return CLI::EXIT_CODES::ERR_UNKNOWN;
+    }
+
+    const wxString formatName = SCH_IO_MGR::ShowType( fileType );
+
+    m_reporter->Report( wxString::Format( _( "Importing '%s' using %s format...\n" ),
+                                          inputFn.GetFullPath(), formatName ),
+                        RPT_SEVERITY_INFO );
+
+    COLLECTING_REPORTER importReporter;
+    LOCALE_IO           dummy;
+
+    std::unique_ptr<SCHEMATIC> schematic = std::make_unique<SCHEMATIC>( project );
+    SCH_SHEET_LIST             sheetList;
+
+    try
+    {
+        LOAD_INFO_REPORTER_SCOPE loadInfoScope( &importReporter );
+        IO_RELEASER<SCH_IO>      pi( SCH_IO_MGR::FindPlugin( fileType ) );
+
+        pi->SetReporter( &importReporter );
+
+        if( isAltiumProject )
+        {
+            // The importer makes every sheet without a parent a top-level sheet itself.
+            std::map<std::string, UTF8> props = altiumProjectProperties( inputFn, importReporter );
+
+            if( !pi->LoadSchematicFile( wxEmptyString, schematic.get(), nullptr, &props )
+                || schematic->GetTopLevelSheets().empty() )
+            {
+                m_reporter->Report( _( "Failed to load project schematics\n" ), RPT_SEVERITY_ERROR );
+                return CLI::EXIT_CODES::ERR_INVALID_INPUT_FILE;
+            }
+
+            // Sheets keep their source names, except the first top-level sheet, which becomes
+            // the requested output file so it can be passed straight to other commands.
+            SCH_SHEET* firstSheet = schematic->GetTopLevelSheets().front();
+            firstSheet->SetFileName( outputFn.GetFullName() );
+            firstSheet->GetScreen()->SetFileName( outputFn.GetFullPath() );
+        }
+        else
+        {
+            SCH_SHEET* loadedSheet = pi->LoadSchematicFile( inputFn.GetFullPath(), schematic.get() );
+
+            if( !loadedSheet )
+            {
+                m_reporter->Report( _( "Failed to load schematic\n" ), RPT_SEVERITY_ERROR );
+                return CLI::EXIT_CODES::ERR_INVALID_INPUT_FILE;
+            }
+
+            schematic->SetTopLevelSheets( { loadedSheet } );
+
+            if( loadedSheet->GetName().IsEmpty() )
+                loadedSheet->SetName( _( "Root" ) );
+
+            loadedSheet->SetFileName( outputFn.GetFullName() );
+            loadedSheet->GetScreen()->SetFileName( outputFn.GetFullPath() );
+        }
+
+        // Non-KiCad schematics do not use a KiCad drawing sheet; match the interactive import.
+        DS_DATA_MODEL::GetTheInstance().SetEmptyLayout();
+        BASE_SCREEN::m_DrawingSheetFileName = "empty.kicad_wks";
+
+        sheetList = schematic->BuildSheetListSortedByPageNumbers();
+        SCH_SCREENS screens( schematic->Root() );
+
+        for( SCH_SCREEN* screen = screens.GetFirst(); screen; screen = screens.GetNext() )
+            screen->UpdateLocalLibSymbolLinks();
+
+        sheetList.AnnotatePowerSymbols();
+
+        if( sheetList.AllSheetPageNumbersEmpty() )
+            sheetList.SetInitialPageNumbers();
+        else
+            sheetList.RepairPageNumbers();
+
+        TOOL_MANAGER toolManager;
+        toolManager.SetEnvironment( schematic.get(), nullptr, nullptr, Kiface().KifaceSettings(),
+                                    nullptr );
+
+        SCH_COMMIT dummyCommit( &toolManager );
+        schematic->RecalculateConnections( &dummyCommit, GLOBAL_CLEANUP, &toolManager );
+        schematic->SetSheetNumberAndCount();
+
+        for( SCH_SHEET_PATH& sheet : sheetList )
+        {
+            sheet.UpdateAllScreenReferences();
+            sheet.LastScreen()->TestDanglingEnds( nullptr, nullptr );
+        }
+
+        IO_RELEASER<SCH_IO> kicadIo( SCH_IO_MGR::FindPlugin( SCH_IO_MGR::SCH_KICAD ) );
+
+        for( size_t i = 0; i < screens.GetCount(); i++ )
+        {
+            SCH_SCREEN* screen = screens.GetScreen( i );
+
+            // The virtual root only holds the top-level sheets; it has no file of its own.
+            if( screens.GetSheet( i )->m_Uuid == niluuid )
+                continue;
+
+            wxFileName screenFn( screen->GetFileName() );
+
+            // Every sheet goes next to the top-level output, whatever path the importer chose.
+            screenFn.SetPath( outputFn.GetPath() );
+            screenFn.SetExt( FILEEXT::KiCadSchematicFileExtension );
+            screen->SetFileName( screenFn.GetFullPath() );
+
+            kicadIo->SaveSchematicFile( screenFn.GetFullPath(), screens.GetSheet( i ),
+                                        schematic.get() );
+        }
+
+        // Record the top-level sheets so the project opens with all of them.
+        std::vector<TOP_LEVEL_SHEET_INFO>& projectSheets =
+                project->GetProjectFile().GetTopLevelSheets();
+        projectSheets.clear();
+
+        for( SCH_SHEET* sheet : schematic->GetTopLevelSheets() )
+        {
+            wxFileName sheetFn( sheet->GetScreen()->GetFileName() );
+            sheetFn.MakeRelativeTo( outputFn.GetPath() );
+            projectSheets.emplace_back( sheet->m_Uuid, sheet->GetName(), sheetFn.GetFullPath() );
+        }
+
+        mgr.SaveProject( proFn.GetFullPath(), project );
+    }
+    catch( const IO_ERROR& ioe )
+    {
+        m_reporter->Report( wxString::Format( _( "Error during import: %s\n" ), ioe.What() ),
+                            RPT_SEVERITY_ERROR );
+        return CLI::EXIT_CODES::ERR_UNKNOWN;
+    }
+    catch( const std::exception& exc )
+    {
+        m_reporter->Report( wxString::Format( _( "Error during import: %s\n" ), exc.what() ),
+                            RPT_SEVERITY_ERROR );
+        return CLI::EXIT_CODES::ERR_UNKNOWN;
+    }
+
+    m_reporter->Report( wxString::Format( _( "Successfully saved imported schematic to '%s'\n" ),
+                                          outputFn.GetFullPath() ),
+                        RPT_SEVERITY_INFO );
+
+    if( job->m_reportFormat == JOB_SCH_IMPORT::REPORT_FORMAT::NONE )
+        return CLI::EXIT_CODES::SUCCESS;
+
+    size_t symbolCount = 0;
+
+    for( const SCH_SHEET_PATH& sheet : sheetList )
+    {
+        for( SCH_ITEM* item : sheet.LastScreen()->Items().OfType( SCH_SYMBOL_T ) )
+        {
+            wxUnusedVar( item );
+            symbolCount++;
+        }
+    }
+
+    wxString reportOutput;
+
+    if( job->m_reportFormat == JOB_SCH_IMPORT::REPORT_FORMAT::JSON )
+    {
+        nlohmann::json warnings = nlohmann::json::array();
+        nlohmann::json errors = nlohmann::json::array();
+
+        for( const auto& [text, severity] : importReporter.m_messages )
+        {
+            if( severity == RPT_SEVERITY_ERROR )
+                errors.push_back( text.ToStdString() );
+            else if( severity == RPT_SEVERITY_WARNING )
+                warnings.push_back( text.ToStdString() );
+        }
+
+        nlohmann::json report;
+        report["source_file"] = inputFn.GetFullName().ToStdString();
+        report["source_format"] = formatName.ToStdString();
+        report["output_file"] = outputFn.GetFullName().ToStdString();
+        report["statistics"] = { { "sheets", sheetList.size() }, { "symbols", symbolCount } };
+        report["warnings"] = warnings;
+        report["errors"] = errors;
+
+        reportOutput = wxString::FromUTF8( report.dump( 2 ) );
+    }
+    else
+    {
+        reportOutput += wxS( "Import Report\n=============\n\n" );
+        reportOutput += wxString::Format( wxS( "Source file: %s\n" ), inputFn.GetFullName() );
+        reportOutput += wxString::Format( wxS( "Source format: %s\n" ), formatName );
+        reportOutput += wxString::Format( wxS( "Output file: %s\n\n" ), outputFn.GetFullName() );
+        reportOutput += wxString::Format( wxS( "Statistics:\n  Sheets: %zu\n  Symbols: %zu\n" ),
+                                          sheetList.size(), symbolCount );
+
+        if( !importReporter.m_messages.empty() )
+        {
+            reportOutput += wxS( "\nMessages:\n" );
+
+            for( const auto& [text, severity] : importReporter.m_messages )
+                reportOutput += wxString::Format( wxS( "  - %s\n" ), text );
+        }
+    }
+
+    if( job->m_reportFile.IsEmpty() )
+    {
+        m_reporter->Report( reportOutput + wxS( "\n" ), RPT_SEVERITY_INFO );
+    }
+    else
+    {
+        wxFile file( job->m_reportFile, wxFile::write );
+
+        if( file.IsOpened() )
+            file.Write( reportOutput );
+    }
+
+    return CLI::EXIT_CODES::SUCCESS;
+}
