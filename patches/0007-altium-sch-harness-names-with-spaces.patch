+// Altium harness names and types may contain spaces ("DRIVER DIGITAL INPUT"), which KiCad bus
+// groups use as separators, and Altium matches types regardless of case. Use one KiCad-safe
+// spelling everywhere a harness name or type ends up in a label.
+static wxString harnessName( const wxString& aName )
+{
+    wxString name = aName;
+    name.Trim( true ).Trim( false );
+    name.Replace( wxT( " " ), wxT( "_" ) );
+    return name;
+}
+
+
+static wxString harnessType( const wxString& aType )
+{
+    return harnessName( aType ).Upper();
+}
