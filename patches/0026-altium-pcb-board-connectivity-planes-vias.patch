                 innerRemoved = true;
         }
 
+        // Altium draws no lands on internal planes, and clears a plane from the via's hole: keep
+        // a land there only where the via connects, or KiCad's larger clearances (measured from
+        // the land) cut planes apart in dense via fields (FPGA3: 25 unconnected items).
+        if( !innerRemoved && !endRemoved )
+        {
+            for( PCB_LAYER_ID layer : LSET( via->GetLayerSet() & LSET::InternalCuMask() ).Seq() )
+            {
+                if( m_board->GetLayerType( layer ) == LT_POWER )
+                {
+                    innerRemoved = true;
+                    break;
+                }
+            }
+        }
+
         if( innerRemoved || endRemoved )
         {
-            via->Padstack().SetUnconnectedLayerMode(
-                    endRemoved ? UNCONNECTED_LAYER_MODE::REMOVE_ALL
-                               : UNCONNECTED_LAYER_MODE::REMOVE_EXCEPT_START_AND_END );
+            // Start and end lands stay: Altium removes them under a pad that covers the via
+            // (via in pad), and KiCad would not join the pad to an unflashed via
+            via->Padstack().SetUnconnectedLayerMode( UNCONNECTED_LAYER_MODE::REMOVE_EXCEPT_START_AND_END );
         }
 
