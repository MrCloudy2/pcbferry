+    // Altium draws no lands on internal planes and clears a plane from the hole; KiCad clears it
+    // from the land, which cuts planes apart between tight-pitch pins (Kasli: connector GND pins
+    // cut off). Plated pads crossing a plane keep lands only where something connects, as vias
+    // on planes do (see ParseVias6Data).
+    LSET planeLayers;
+
+    for( PCB_LAYER_ID layer : LSET( m_board->GetEnabledLayers() & LSET::InternalCuMask() ).Seq() )
+    {
+        if( m_board->GetLayerType( layer ) == LT_POWER )
+            planeLayers.set( layer );
+    }
+
+    if( planeLayers.any() )
+    {
+        for( FOOTPRINT* fp : m_board->Footprints() )
+        {
+            for( PAD* pad : fp->Pads() )
+            {
+                if( pad->GetAttribute() == PAD_ATTRIB::PTH
+                    && pad->Padstack().UnconnectedLayerMode() == UNCONNECTED_LAYER_MODE::KEEP_ALL
+                    && ( pad->GetLayerSet() & planeLayers ).any() )
+                {
+                    pad->Padstack().SetUnconnectedLayerMode( UNCONNECTED_LAYER_MODE::REMOVE_EXCEPT_START_AND_END );
+                }
+            }
+        }
+    }
+
+    // A via or pad that drops unconnected lands keeps its land where an imported pour of its net
+    // covers it: KiCad only learns that when it fills the zone itself, and the pours come filled
+    // from Altium. And Altium connects a track or arc ending anywhere on the land, KiCad only at
+    // the item when the land may go: such ends get a short stub of the same width to the centre,
+    // inside the land, so nothing else moves.
+    std::vector<PCB_TRACK*> stubs;
+
+    auto keepLands = [&]( BOARD_CONNECTED_ITEM* aItem, const VECTOR2I& aPos,
+                          const std::function<int( PCB_LAYER_ID )>& aRadius,
+                          const std::function<void( PCB_LAYER_ID )>& aFlash )
+    {
+        for( PCB_LAYER_ID layer : LSET( aItem->GetLayerSet() & LSET::AllCuMask() ).Seq() )
+        {
+            int radius = aRadius( layer );
+
+            for( PCB_TRACK* other : m_board->Tracks() )
+            {
+                if( ( other->Type() != PCB_TRACE_T && other->Type() != PCB_ARC_T )
+                    || other->GetLayer() != layer || other->GetNetCode() != aItem->GetNetCode() )
+                {
+                    continue;
+                }
+
+                for( const VECTOR2I& end : { other->GetStart(), other->GetEnd() } )
+                {
+                    // Overlapping copper counts, not only the centre line
+                    if( end != aPos && ( end - aPos ).EuclideanNorm() <= radius + other->GetWidth() / 2 )
+                    {
+                        PCB_TRACK* stub = new PCB_TRACK( m_board );
+                        stub->SetStart( end );
+                        stub->SetEnd( aPos );
+                        stub->SetWidth( other->GetWidth() );
+                        stub->SetLayer( layer );
+                        stub->SetNetCode( other->GetNetCode() );
+                        stubs.push_back( stub );
+                    }
+                }
+            }
+
+            for( ZONE* zone : m_polygons )
+            {
+                if( zone && zone->GetNetCode() == aItem->GetNetCode() && zone->IsOnLayer( layer )
+                    && zone->HasFilledPolysForLayer( layer )
+                    && zone->GetFilledPolysList( layer )->Collide( aPos, radius ) )
+                {
+                    aFlash( layer );
+                    break;
+                }
+            }
+        }
+    };
+
+    for( PCB_TRACK* track : m_board->Tracks() )
+    {
+        if( track->Type() != PCB_VIA_T )
+            continue;
+
+        PCB_VIA* via = static_cast<PCB_VIA*>( track );
+
+        if( via->Padstack().UnconnectedLayerMode() == UNCONNECTED_LAYER_MODE::KEEP_ALL )
+            continue;
+
+        keepLands( via, via->GetPosition(),
+                   [&]( PCB_LAYER_ID aLayer ) { return via->GetWidth( aLayer ) / 2; },
+                   [&]( PCB_LAYER_ID aLayer ) { via->SetZoneLayerOverride( aLayer, ZLO_FORCE_FLASHED ); } );
+    }
+
+    for( FOOTPRINT* fp : m_board->Footprints() )
+    {
+        for( PAD* pad : fp->Pads() )
+        {
+            if( pad->GetAttribute() != PAD_ATTRIB::PTH
+                || pad->Padstack().UnconnectedLayerMode() == UNCONNECTED_LAYER_MODE::KEEP_ALL )
+            {
+                continue;
+            }
+
+            keepLands( pad, pad->GetPosition(),
+                       [&]( PCB_LAYER_ID aLayer )
+                       {
+                           VECTOR2I size = pad->GetSize( aLayer );
+                           return std::min( size.x, size.y ) / 2;
+                       },
+                       [&]( PCB_LAYER_ID aLayer ) { pad->SetZoneLayerOverride( aLayer, ZLO_FORCE_FLASHED ); } );
+        }
+    }
+
+    for( PCB_TRACK* stub : stubs )
+        m_board->Add( stub, ADD_MODE::APPEND );
