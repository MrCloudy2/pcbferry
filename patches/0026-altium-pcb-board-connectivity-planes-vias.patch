+        else if( pad->GetAttribute() == PAD_ATTRIB::PTH && pad->Padstack().Mode() == PADSTACK::MODE::NORMAL
+                 && ( size.x < pad->GetDrillSize().x || size.y < pad->GetDrillSize().y ) )
+        {
+            // A plated hole with a pad smaller than the hole (mounting holes): the copper is
