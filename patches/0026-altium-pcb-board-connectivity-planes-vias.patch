+            auto keepInPours = [&]( BOARD_CONNECTED_ITEM* aItem, const VECTOR2I& aPos, int aRadius )
+            {
+                for( PCB_LAYER_ID layer : LSET( aItem->GetLayerSet() & LSET::AllCuMask() ).Seq() )
+                {
+                    for( ZONE* zone : board->Zones() )
+                    {
+                        if( !zone->GetIsRuleArea() && zone->GetNetCode() == aItem->GetNetCode()
+                            && zone->IsOnLayer( layer ) && zone->HasFilledPolysForLayer( layer )
+                            && zone->GetFilledPolysList( layer )->Collide( aPos, aRadius ) )
+                        {
+                            if( aItem->Type() == PCB_VIA_T )
+                                static_cast<PCB_VIA*>( aItem )->SetZoneLayerOverride( layer, ZLO_FORCE_FLASHED );
+                            else
+                                static_cast<PAD*>( aItem )->SetZoneLayerOverride( layer, ZLO_FORCE_FLASHED );
+
+                            break;
+                        }
+                    }
+                }
+            };
+
+            for( FOOTPRINT* fp : board->Footprints() )
+            {
+                for( PAD* pad : fp->Pads() )
+                {
+                    if( pad->GetAttribute() == PAD_ATTRIB::PTH )
+                        keepInPours( pad, pad->GetPosition(), pad->GetDrillSize().x / 2 );
+                }
+            }
+
+            for( PCB_TRACK* track : board->Tracks() )
+            {
+                if( track->Type() == PCB_VIA_T )
+                    keepInPours( track, track->GetPosition(), static_cast<PCB_VIA*>( track )->GetDrillValue() / 2 );
+            }
